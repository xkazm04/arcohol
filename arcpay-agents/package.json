{
  "name": "@arcpay/agents",
  "version": "0.1.0",
  "description": "AI Agent Payment Infrastructure - Autonomous wallets, budgets, and payment rails for AI agents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet/index.mjs",
      "require": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts"
    },
    "./budget": {
      "import": "./dist/budget/index.mjs",
      "require": "./dist/budget/index.js",
      "types": "./dist/budget/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai-agents",
    "autonomous-payments",
    "agent-wallet",
    "budget-management",
    "usdc",
    "stablecoin",
    "web3",
    "llm"
  ],
  "author": "ArcPay",
  "license": "MIT",
  "dependencies": {
    "@arcpay/x402": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
