{
  "name": "@arcpay/crosschain",
  "version": "0.1.0",
  "description": "Cross-Chain Treasury Router - Multi-chain treasury management with Circle CCTP V2",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./treasury": {
      "import": "./dist/treasury/index.mjs",
      "require": "./dist/treasury/index.js",
      "types": "./dist/treasury/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.mjs",
      "require": "./dist/router/index.js",
      "types": "./dist/router/index.d.ts"
    },
    "./bridges": {
      "import": "./dist/bridges/index.mjs",
      "require": "./dist/bridges/index.js",
      "types": "./dist/bridges/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cross-chain",
    "multi-chain",
    "treasury",
    "cctp",
    "circle",
    "usdc",
    "bridge",
    "routing"
  ],
  "author": "ArcPay",
  "license": "MIT",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
